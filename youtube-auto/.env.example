# ============================================================
#  SAO CHÉP FILE NÀY THÀNH .env VÀ ĐIỀN API KEYS VÀO
# ============================================================

# Text chính: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite

# Text fallback + tạo ảnh: Cloudflare Dashboard > Workers AI > Use REST API
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_workers_ai_token_here
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
